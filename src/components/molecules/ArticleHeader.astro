---
import FormattedDate from "../atoms/FormattedDate.astro";
import TagList from "../atoms/TagList.astro";

interface Props {
  title: string;
  date: string;
  tags?: string[];
}

const { title, date, tags = [] } = Astro.props;
---

<header class="mb-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">{title}</h1>
  <FormattedDate date={date} />
  <TagList tags={tags} class="mt-3" />
</header>
