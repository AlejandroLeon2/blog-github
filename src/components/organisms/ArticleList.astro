---
import ArticleMeta from "../molecules/ArticleMeta.astro";

interface Article {
  slug: string;
  title: string;
  date: string;
  tags?: string[];
  category?: string;
  description?: string;
}

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

<div class="flex flex-col gap-4" data-article-list>
  {articles.length === 0 ? (
    <p class="text-gray-500 text-center py-8">No hay artículos todavía.</p>
  ) : (
    articles.map((article) => (
      <div
        data-article
        data-title={article.title}
        data-description={article.description ?? ""}
        data-category={article.category ?? ""}
        data-tags={(article.tags ?? []).join(",")}
      >
        <ArticleMeta
          slug={article.slug}
          title={article.title}
          date={article.date}
          tags={article.tags}
          category={article.category}
          description={article.description}
        />
      </div>
    ))
  )}
</div>
