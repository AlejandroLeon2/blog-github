---
interface Option {
  value: string;
  label: string;
}

interface Props {
  options: Option[];
  value?: string;
  id?: string;
  class?: string;
}

const { options = [], value = "", id, class: className } = Astro.props;
---

<select
  class:list={[
    "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
    className,
  ]}
  id={id}
>
  {options.map((opt) => (
    <option value={opt.value} selected={opt.value === value}>
      {opt.label}
    </option>
  ))}
</select>
