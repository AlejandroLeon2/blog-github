---
interface Props {
  variant?: "primary" | "secondary" | "danger";
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  id?: string;
  class?: string;
}

const {
  variant = "primary",
  disabled = false,
  type = "button",
  id,
  class: className,
} = Astro.props;

const base =
  "px-4 py-2 rounded-lg font-medium text-sm transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed";

const variants: Record<string, string> = {
  primary: "bg-blue-600 text-white hover:bg-blue-700",
  secondary: "bg-gray-200 text-gray-800 hover:bg-gray-300",
  danger: "bg-red-600 text-white hover:bg-red-700",
};
---

<button
  class:list={[base, variants[variant], className]}
  type={type}
  disabled={disabled}
  id={id}
>
  <slot />
</button>
