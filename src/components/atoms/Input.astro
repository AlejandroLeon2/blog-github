---
interface Props {
  type?: "text" | "password" | "email" | "number" | "date" | "search" | "url" | "tel";
  placeholder?: string;
  value?: string;
  name?: string;
  id?: string;
  class?: string;
}

const {
  type = "text",
  placeholder = "",
  value = "",
  name = "",
  id,
  class: className,
} = Astro.props;
---

<input
  class:list={[
    "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
    className,
  ]}
  type={type}
  placeholder={placeholder}
  value={value}
  name={name}
  id={id}
/>
