---
interface Props {
  rows?: number;
  cols?: number;
  placeholder?: string;
  value?: string;
  id?: string;
}

const {
  rows = 10,
  cols = 60,
  placeholder = "",
  value = "",
  id,
} = Astro.props;
---

<textarea
  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-y"
  rows={rows}
  cols={cols}
  placeholder={placeholder}
  id={id}
>{value}</textarea>
