---
import Button from "../atoms/Button.astro";
---

<div id="image-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">Subir imagen</h3>
      <button id="close-image-modal" class="text-gray-400 hover:text-gray-600 text-xl leading-none">&times;</button>
    </div>

    <!-- Body -->
    <div class="px-5 py-4">
      <p class="text-sm text-gray-500 mb-3">
        Seleccioná una imagen del dispositivo. Se guardará en
        <code class="bg-gray-100 px-1 rounded text-xs">/images/</code> del repositorio.
      </p>

      <input
        id="image-file-input"
        type="file"
        accept="image/*"
        class="block w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer"
      />

      <img id="image-preview" class="hidden mt-3 max-h-48 rounded-lg border border-gray-200 object-contain w-full" alt="Preview" />
    </div>

    <!-- Footer -->
    <div class="flex justify-end gap-2 px-5 py-3 border-t border-gray-200 bg-gray-50">
      <Button id="cancel-image-modal" variant="secondary">Cancelar</Button>
      <Button id="confirm-image-upload">Subir</Button>
    </div>
  </div>
</div>
